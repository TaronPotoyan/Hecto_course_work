# Copy to .env and fill in.
PORT=3000

# PostgreSQL connection string. Point it at your Postgres instance
# (e.g. your existing container on port 5433, or `docker compose up -d` here -> 5432).
# The database is created automatically by `npm run db:migrate` if it doesn't exist.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/heckto

# Secret used to sign auth tokens. Use a long random string (>= 32 chars).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Allowed browser origin(s) for CORS, comma separated.
CORS_ORIGIN=http://localhost:4200

# Support chatbot (Claude). Leave empty if you're logged in with `ant auth login`.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
